# Leave empty for local dev (defaults to http://localhost:3001)
# Set to your deployed server URL for production (e.g., https://sendora-server.onrender.com)
VITE_SIGNALING_URL=

# TURN server credentials from https://www.metered.ca/stun-turn (free tier)
# Required for connections behind symmetric NATs / strict firewalls
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
